# =============================================================================
# Restaurant Management & POS System - Environment Variables (root reference)
# Copy this file to server/.env and client/.env and fill in real values.
# NEVER commit .env files.
# =============================================================================

# --- Server (server/.env) ---------------------------------------------------
NODE_ENV=development
PORT=4000
SERVER_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string (used from Phase 2 onward)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_db

# JWT secrets (used from Phase 3 onward) - use long random strings in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional: Redis for caching / rate limiting / pub-sub
REDIS_URL=redis://localhost:6379

# Optional: Cloudinary for image uploads (menu item images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Client (client/.env) ---------------------------------------------------
# Base URL for API requests. Leave as /api to use the Vite dev-server proxy.
VITE_API_BASE_URL=/api
# Socket.IO endpoint. Leave empty to use the Vite dev-server proxy (same origin).
VITE_SOCKET_URL=
# Optional: override the dev proxy target (defaults to http://localhost:4000)
VITE_PROXY_TARGET=http://localhost:4000