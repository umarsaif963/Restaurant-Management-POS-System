# -----------------------------------------------------------------------------
# Restaurant Management & POS System - Server environment
# Copy to server/.env and fill in real values. NEVER commit .env.
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
SERVER_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string (used from Phase 2 onward)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_db

# JWT secrets (used from Phase 3 onward)
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional: Redis
REDIS_URL=redis://localhost:6379

# Optional: Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=