// ===========================================================================
// Restaurant Management & POS System - PostgreSQL schema
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN_STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum MenuItemStatus {
  ACTIVE
  INACTIVE
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum KitchenOrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum KitchenItemStatus {
  WAITING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
}

enum StockUnit {
  KG
  GRAM
  LITER
  ML
  PIECE
  PACK
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  ADJUSTMENT
  WASTAGE
  RETURN
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Identity & configuration
// ---------------------------------------------------------------------------

model Restaurant {
  id               String   @id @default(cuid())
  name             String
  logoUrl          String?
  address          String?
  phone            String?
  email            String?
  currency         String   @default("USD")
  taxPercentage    Decimal  @default(0) @db.Decimal(5, 2)
  serviceChargePct Decimal  @default(0) @db.Decimal(5, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  settings RestaurantSettings?
}

model RestaurantSettings {
  id                         String     @id @default(cuid())
  restaurantId               String     @unique
  restaurant                 Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  taxPercentage              Decimal    @default(0) @db.Decimal(5, 2)
  serviceChargePct           Decimal    @default(0) @db.Decimal(5, 2)
  currency                   String     @default("USD")
  receiptHeader              String?
  receiptFooter              String?
  orderNumberPrefix          String     @default("ORD")
  orderNumberStart           Int        @default(1)
  openingHours               Json?
  showTaxOnReceipt           Boolean    @default(true)
  showServiceChargeOnReceipt Boolean    @default(true)
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id          String     @id @default(cuid())
  name        String
  email       String     @unique
  phone       String?
  password    String
  role        UserRole
  status      UserStatus @default(ACTIVE)
  pin         String?
  avatarUrl   String?
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  takenOrders           Order[]        @relation("OrderTaker")
  receivedPayments      Payment[]      @relation("PaymentReceiver")
  acceptedKitchenOrders KitchenOrder[] @relation("KitchenAcceptor")
  createdReservations   Reservation[]  @relation("ReservationCreator")
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  auditLogs             AuditLog[]
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Tables
// ---------------------------------------------------------------------------

model TableSection {
  id        String            @id @default(cuid())
  name      String
  position  Int               @default(0)
  tables    RestaurantTable[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

// Named "RestaurantTable" because "Table" is awkward in code queries.
model RestaurantTable {
  id          String        @id @default(cuid())
  tableNumber Int           @unique
  name        String?
  capacity    Int           @default(2)
  sectionId   String?
  section     TableSection? @relation(fields: [sectionId], references: [id])
  status      TableStatus   @default(AVAILABLE)
  qrCodeUrl   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orders       Order[]
  reservations Reservation[]

  @@index([sectionId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  email         String?
  address       String?
  notes         String?
  totalOrders   Int      @default(0)
  totalSpending Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders       Order[]
  reservations Reservation[]

  @@index([phone])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Menu
// ---------------------------------------------------------------------------

model MenuCategory {
  id          String         @id @default(cuid())
  name        String
  description String?
  position    Int            @default(0)
  status      MenuItemStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items MenuItem[]
}

model MenuItem {
  id              String         @id @default(cuid())
  name            String
  description     String?
  price           Decimal        @db.Decimal(12, 2)
  sku             String?        @unique
  categoryId      String
  category        MenuCategory   @relation(fields: [categoryId], references: [id])
  taxRate         Decimal        @default(0) @db.Decimal(5, 2)
  preparationTime Int?
  available       Boolean        @default(true)
  imageUrl        String?
  position        Int            @default(0)
  status          MenuItemStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  variations        MenuItemVariation[]
  addOns            AddOn[]
  recipes           Recipe[]
  orderItems        OrderItem[]
  kitchenOrderItems KitchenOrderItem[]

  @@index([categoryId])
  @@index([name])
}

model MenuItemVariation {
  id              String   @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name            String
  priceAdjustment Decimal  @default(0) @db.Decimal(12, 2)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([menuItemId])
}

model AddOn {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal  @db.Decimal(12, 2)
  available  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([menuItemId])
}

// ---------------------------------------------------------------------------
// Orders & billing
// ---------------------------------------------------------------------------

model Order {
  id                  String           @id @default(cuid())
  orderNumber         String           @unique
  orderType           OrderType        @default(DINE_IN)
  status              OrderStatus      @default(PENDING)
  paymentStatus       PaymentStatus    @default(UNPAID)
  customerId          String?
  customer            Customer?        @relation(fields: [customerId], references: [id])
  tableId             String?
  table               RestaurantTable? @relation(fields: [tableId], references: [id])
  userId              String
  user                User             @relation("OrderTaker", fields: [userId], references: [id])
  subtotal            Decimal          @default(0) @db.Decimal(12, 2)
  itemDiscountTotal   Decimal          @default(0) @db.Decimal(12, 2)
  discountAmount      Decimal          @default(0) @db.Decimal(12, 2)
  taxAmount           Decimal          @default(0) @db.Decimal(12, 2)
  serviceChargeAmount Decimal          @default(0) @db.Decimal(12, 2)
  grandTotal          Decimal          @default(0) @db.Decimal(12, 2)
  totalPaid           Decimal          @default(0) @db.Decimal(12, 2)
  balanceDue          Decimal          @default(0) @db.Decimal(12, 2)
  notes               String?
  kitchenNotes        String?
  cancelledReason     String?
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  items         OrderItem[]
  payments      Payment[]
  kitchenOrders KitchenOrder[]

  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@index([tableId])
  @@index([customerId])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id])
  name           String
  variationName  String?
  addOns         Json?
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  lineTotal      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  kitchenOrderItems KitchenOrderItem[]

  @@index([orderId])
  @@index([menuItemId])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(CASH)
  transactionRef String?
  receivedById   String?
  receivedBy     User?         @relation("PaymentReceiver", fields: [receivedById], references: [id])
  changeDue      Decimal?      @db.Decimal(12, 2)
  notes          String?
  isRefund       Boolean       @default(false)
  refundOfId     String?
  refundOf       Payment?      @relation("PaymentRefunds", fields: [refundOfId], references: [id], onDelete: SetNull)
  refunds        Payment[]     @relation("PaymentRefunds")
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([orderId])
  @@index([receivedById])
  @@index([paidAt])
}

// ---------------------------------------------------------------------------
// Kitchen
// ---------------------------------------------------------------------------

model KitchenOrder {
  id           String             @id @default(cuid())
  orderId      String
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketNumber Int                @default(1)
  status       KitchenOrderStatus @default(PENDING)
  acceptedById String?
  acceptedBy   User?              @relation("KitchenAcceptor", fields: [acceptedById], references: [id])
  notes        String?
  startedAt    DateTime?
  readyAt      DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  items KitchenOrderItem[]

  @@index([orderId])
  @@index([status])
}

model KitchenOrderItem {
  id             String            @id @default(cuid())
  kitchenOrderId String
  kitchenOrder   KitchenOrder      @relation(fields: [kitchenOrderId], references: [id], onDelete: Cascade)
  orderItemId    String
  orderItem      OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem          @relation(fields: [menuItemId], references: [id])
  name           String
  quantity       Int
  notes          String?
  variant        String?
  status         KitchenItemStatus @default(WAITING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([kitchenOrderId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Reservations
// ---------------------------------------------------------------------------

model Reservation {
  id           String            @id @default(cuid())
  customerName String
  phone        String?
  customerId   String?
  customer     Customer?         @relation(fields: [customerId], references: [id])
  tableId      String?
  table        RestaurantTable?  @relation(fields: [tableId], references: [id])
  guests       Int               @default(2)
  date         DateTime
  notes        String?
  status       ReservationStatus @default(PENDING)
  createdById  String?
  createdBy    User?             @relation("ReservationCreator", fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([date])
  @@index([tableId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Inventory, recipes, suppliers
// ---------------------------------------------------------------------------

model InventoryItem {
  id          String    @id @default(cuid())
  name        String
  sku         String?   @unique
  unit        StockUnit @default(PIECE)
  quantity    Decimal   @default(0) @db.Decimal(12, 3)
  minQuantity Decimal   @default(0) @db.Decimal(12, 3)
  costPrice   Decimal   @default(0) @db.Decimal(12, 2)
  category    String?
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  expiryDate  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  transactions      InventoryTransaction[]
  recipeIngredients RecipeIngredient[]
  purchaseItems     PurchaseItem[]

  @@index([name])
  @@index([category])
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem            @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type            InventoryTransactionType
  quantity        Decimal                  @db.Decimal(12, 3)
  balanceAfter    Decimal?                 @db.Decimal(12, 3)
  unitCost        Decimal?                 @db.Decimal(12, 2)
  note            String?
  referenceIds    String?
  userId          String?
  createdAt       DateTime                 @default(now())

  @@index([inventoryItemId])
  @@index([type])
  @@index([createdAt])
}

model Recipe {
  id         String   @id @default(cuid())
  menuItemId String   @unique
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  yield      Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ingredients RecipeIngredient[]
}

model RecipeIngredient {
  id              String        @id @default(cuid())
  recipeId        String
  recipe          Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Decimal       @db.Decimal(12, 3)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([recipeId])
  @@index([inventoryItemId])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  company   String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases      Purchase[]
  inventoryItems InventoryItem[]
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  status         PurchaseStatus @default(PENDING)
  totalAmount    Decimal        @default(0) @db.Decimal(12, 2)
  notes          String?
  receivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items PurchaseItem[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseItem {
  id              String        @id @default(cuid())
  purchaseId      String
  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Decimal       @db.Decimal(12, 3)
  unitCost        Decimal       @db.Decimal(12, 2)
  amount          Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([purchaseId])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
  @@index([userId])
}
