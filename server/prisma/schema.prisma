generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id               String              @id @default(cuid())
  name             String
  logoUrl          String?
  address          String?
  phone            String?
  email            String?
  currency         String              @default("USD")
  taxPercentage    Decimal             @default(0) @db.Decimal(5, 2)
  serviceChargePct Decimal             @default(0) @db.Decimal(5, 2)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  settings         RestaurantSettings?
}

model RestaurantSettings {
  id                         String     @id @default(cuid())
  restaurantId               String     @unique
  taxPercentage              Decimal    @default(0) @db.Decimal(5, 2)
  serviceChargePct           Decimal    @default(0) @db.Decimal(5, 2)
  currency                   String     @default("USD")
  receiptHeader              String?
  receiptFooter              String?
  orderNumberPrefix          String     @default("ORD")
  orderNumberStart           Int        @default(1)
  openingHours               Json?
  showTaxOnReceipt           Boolean    @default(true)
  showServiceChargeOnReceipt Boolean    @default(true)
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
  restaurant                 Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model User {
  id                    String               @id @default(cuid())
  name                  String
  email                 String               @unique
  phone                 String?
  password              String
  role                  UserRole
  status                UserStatus           @default(ACTIVE)
  pin                   String?
  avatarUrl             String?
  lastLoginAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  auditLogs             AuditLog[]
  acceptedKitchenOrders KitchenOrder[]       @relation("KitchenAcceptor")
  takenOrders           Order[]              @relation("OrderTaker")
  passwordResetTokens   PasswordResetToken[]
  receivedPayments      Payment[]            @relation("PaymentReceiver")
  createdReservations   Reservation[]        @relation("ReservationCreator")
  sessions              Session[]
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TableSection {
  id        String            @id @default(cuid())
  name      String
  position  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  tables    RestaurantTable[]
}

model RestaurantTable {
  id           String        @id @default(cuid())
  tableNumber  Int           @unique
  name         String?
  capacity     Int           @default(2)
  sectionId    String?
  status       TableStatus   @default(AVAILABLE)
  qrCodeUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]
  reservations Reservation[]
  section      TableSection? @relation(fields: [sectionId], references: [id])

  @@index([sectionId])
  @@index([status])
}

model Customer {
  id            String        @id @default(cuid())
  name          String
  phone         String?
  email         String?
  address       String?
  notes         String?
  totalOrders   Int           @default(0)
  totalSpending Decimal       @default(0) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orders        Order[]
  reservations  Reservation[]

  @@index([phone])
  @@index([name])
}

model MenuCategory {
  id          String         @id @default(cuid())
  name        String
  description String?
  position    Int            @default(0)
  status      MenuItemStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       MenuItem[]
}

model MenuItem {
  id                String              @id @default(cuid())
  name              String
  description       String?
  price             Decimal             @db.Decimal(12, 2)
  sku               String?             @unique
  categoryId        String
  taxRate           Decimal             @default(0) @db.Decimal(5, 2)
  preparationTime   Int?
  available         Boolean             @default(true)
  imageUrl          String?
  position          Int                 @default(0)
  status            MenuItemStatus      @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  addOns            AddOn[]
  kitchenOrderItems KitchenOrderItem[]
  category          MenuCategory        @relation(fields: [categoryId], references: [id])
  variations        MenuItemVariation[]
  orderItems        OrderItem[]
  recipes           Recipe?

  @@index([categoryId])
  @@index([name])
}

model MenuItemVariation {
  id              String   @id @default(cuid())
  menuItemId      String
  name            String
  priceAdjustment Decimal  @default(0) @db.Decimal(12, 2)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

model AddOn {
  id         String   @id @default(cuid())
  menuItemId String
  name       String
  price      Decimal  @db.Decimal(12, 2)
  available  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

model Order {
  id                  String           @id @default(cuid())
  orderNumber         String           @unique
  orderType           OrderType        @default(DINE_IN)
  status              OrderStatus      @default(PENDING)
  paymentStatus       PaymentStatus    @default(UNPAID)
  customerId          String?
  tableId             String?
  userId              String
  subtotal            Decimal          @default(0) @db.Decimal(12, 2)
  itemDiscountTotal   Decimal          @default(0) @db.Decimal(12, 2)
  discountAmount      Decimal          @default(0) @db.Decimal(12, 2)
  taxAmount           Decimal          @default(0) @db.Decimal(12, 2)
  serviceChargeAmount Decimal          @default(0) @db.Decimal(12, 2)
  grandTotal          Decimal          @default(0) @db.Decimal(12, 2)
  totalPaid           Decimal          @default(0) @db.Decimal(12, 2)
  balanceDue          Decimal          @default(0) @db.Decimal(12, 2)
  notes               String?
  kitchenNotes        String?
  cancelledReason     String?
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  kitchenOrders       KitchenOrder[]
  customer            Customer?        @relation(fields: [customerId], references: [id])
  table               RestaurantTable? @relation(fields: [tableId], references: [id])
  user                User             @relation("OrderTaker", fields: [userId], references: [id])
  items               OrderItem[]
  payments            Payment[]

  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@index([tableId])
  @@index([customerId])
}

model OrderItem {
  id                String             @id @default(cuid())
  orderId           String
  menuItemId        String
  name              String
  variationName     String?
  addOns            Json?
  quantity          Int
  unitPrice         Decimal            @db.Decimal(12, 2)
  lineTotal         Decimal            @db.Decimal(12, 2)
  discountAmount    Decimal            @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal            @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  kitchenOrderItems KitchenOrderItem[]
  menuItem          MenuItem           @relation(fields: [menuItemId], references: [id])
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(CASH)
  transactionRef String?
  receivedById   String?
  changeDue      Decimal?      @db.Decimal(12, 2)
  notes          String?
  isRefund       Boolean       @default(false)
  refundOfId     String?
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedBy     User?         @relation("PaymentReceiver", fields: [receivedById], references: [id])
  refundOf       Payment?      @relation("PaymentRefunds", fields: [refundOfId], references: [id])
  refunds        Payment[]     @relation("PaymentRefunds")

  @@index([orderId])
  @@index([receivedById])
  @@index([paidAt])
}

model KitchenOrder {
  id           String             @id @default(cuid())
  orderId      String
  ticketNumber Int                @default(1)
  status       KitchenOrderStatus @default(PENDING)
  acceptedById String?
  notes        String?
  startedAt    DateTime?
  readyAt      DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  acceptedBy   User?              @relation("KitchenAcceptor", fields: [acceptedById], references: [id])
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items        KitchenOrderItem[]

  @@index([orderId])
  @@index([status])
}

model KitchenOrderItem {
  id             String            @id @default(cuid())
  kitchenOrderId String
  orderItemId    String
  menuItemId     String
  name           String
  quantity       Int
  notes          String?
  variant        String?
  status         KitchenItemStatus @default(WAITING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  kitchenOrder   KitchenOrder      @relation(fields: [kitchenOrderId], references: [id], onDelete: Cascade)
  menuItem       MenuItem          @relation(fields: [menuItemId], references: [id])
  orderItem      OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([kitchenOrderId])
  @@index([status])
}

model Reservation {
  id           String            @id @default(cuid())
  customerName String
  phone        String?
  customerId   String?
  tableId      String?
  guests       Int               @default(2)
  date         DateTime
  notes        String?
  status       ReservationStatus @default(PENDING)
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  createdBy    User?             @relation("ReservationCreator", fields: [createdById], references: [id])
  customer     Customer?         @relation(fields: [customerId], references: [id])
  table        RestaurantTable?  @relation(fields: [tableId], references: [id])

  @@index([date])
  @@index([tableId])
  @@index([status])
}

model InventoryItem {
  id                String                 @id @default(cuid())
  name              String
  sku               String?                @unique
  unit              StockUnit              @default(PIECE)
  quantity          Decimal                @default(0) @db.Decimal(12, 3)
  minQuantity       Decimal                @default(0) @db.Decimal(12, 3)
  costPrice         Decimal                @default(0) @db.Decimal(12, 2)
  category          String?
  supplierId        String?
  expiryDate        DateTime?
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  supplier          Supplier?              @relation(fields: [supplierId], references: [id])
  transactions      InventoryTransaction[]
  purchaseItems     PurchaseItem[]
  recipeIngredients RecipeIngredient[]

  @@index([name])
  @@index([category])
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  inventoryItemId String
  type            InventoryTransactionType
  quantity        Decimal                  @db.Decimal(12, 3)
  balanceAfter    Decimal?                 @db.Decimal(12, 3)
  unitCost        Decimal?                 @db.Decimal(12, 2)
  note            String?
  referenceIds    String?
  userId          String?
  createdAt       DateTime                 @default(now())
  inventoryItem   InventoryItem            @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([type])
  @@index([createdAt])
}

model Recipe {
  id          String             @id @default(cuid())
  menuItemId  String             @unique
  name        String
  yield       Int                @default(1)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  menuItem    MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
}

model RecipeIngredient {
  id              String        @id @default(cuid())
  recipeId        String
  inventoryItemId String
  quantity        Decimal       @db.Decimal(12, 3)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  recipe          Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([inventoryItemId])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  company        String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventoryItems InventoryItem[]
  purchases      Purchase[]
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String
  status         PurchaseStatus @default(PENDING)
  totalAmount    Decimal        @default(0) @db.Decimal(12, 2)
  notes          String?
  receivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  items          PurchaseItem[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseItem {
  id              String        @id @default(cuid())
  purchaseId      String
  inventoryItemId String
  quantity        Decimal       @db.Decimal(12, 3)
  unitCost        Decimal       @db.Decimal(12, 2)
  amount          Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entity])
  @@index([userId])
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN_STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum MenuItemStatus {
  ACTIVE
  INACTIVE
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum KitchenOrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum KitchenItemStatus {
  WAITING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
}

enum StockUnit {
  KG
  GRAM
  LITER
  ML
  PIECE
  PACK
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  ADJUSTMENT
  WASTAGE
  RETURN
  DAMAGE
  ORDER_CANCEL
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}
