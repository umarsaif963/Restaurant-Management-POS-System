# -----------------------------------------------------------------------------
# Restaurant Management & POS System - Client environment
# Copy to client/.env. Vite only exposes variables prefixed with VITE_.
# -----------------------------------------------------------------------------

# Base URL for API requests. Use /api with the dev proxy (see vite.config.ts).
VITE_API_BASE_URL=/api

# Socket.IO endpoint. Leave empty to use the same-origin dev proxy.
VITE_SOCKET_URL=

# Optional: dev proxy target (defaults to http://localhost:4000)
VITE_PROXY_TARGET=http://localhost:4000